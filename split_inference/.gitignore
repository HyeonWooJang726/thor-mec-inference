# Override repository-wide data/ exclusion for documentation and manifests.
!/data/
/data/*
!/data/README.md
!/data/manifests/
# Dataset images and archives
*.zip
*.tar
*.tar.gz
*.tgz
*.JPEG
*.jpeg
*.jpg
*.JPG
/data/imagenet*/
/data/images/
# Model artifacts
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.engine
*.plan
/weights/*
!/weights/README.md
# Raw observations and tensor dumps (keep local, never delete to clean Git)
/results/profiling/raw/*
/results/thor_processing_profile/*
/results/thor_imagenet_profile/
# Publish only the final composite PNG/PDF; keep measurements and other artifacts local.
!/results/thor_processing_profile/20260915T181507/
/results/thor_processing_profile/20260915T181507/*
!/results/thor_processing_profile/20260915T181507/layer_group_characteristics/
/results/thor_processing_profile/20260915T181507/layer_group_characteristics/*
!/results/thor_processing_profile/20260915T181507/layer_group_characteristics/efficientnetv2s_layer_group_characteristics.png
!/results/thor_processing_profile/20260915T181507/layer_group_characteristics/efficientnetv2s_layer_group_characteristics.pdf
*.npy
*.npz
*.bin
*.tensor
*.pkl
*.pickle
# Python environments and caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
# README, configs, manifests, summary CSV, PNG/PDF/SVG remain trackable.
