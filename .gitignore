# 로컬 환경 변수와 자격 증명
.env
.env.*
credentials
credentials/**
*credentials*
*api_key*
*apikey*
*token*
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.pem
*.key

# 모델과 TensorRT 생성물
*.onnx
*.engine
*.plan

# 저장소 위치와 무관하게 보호할 연구 raw artifact
*.bin
*.log
*.mp4
*.avi
*.mkv
*.mov
datasets/
dataset/
data/

# raw 결과와 로그는 로컬에 보존하되 공개 Git에는 포함하지 않는다.
logs/*
results/**
!results/**/
!logs/.gitkeep
!results/.gitkeep
# 분류 index와 tracked target을 가리키는 상대 symlink만 공개한다.
# 기존 tracked artifact는 원래 index/경로를 유지한다. 새 raw 파일은 무시한다.
!results/INDEX.md
!results/active/README.md
!results/reference/README.md
!results/reference/local_canonical_c2
!results/archive/README.md
!results/archive/early_characterization/README.md
!results/archive/early_characterization/decode_profiling
!results/archive/early_characterization/local_realtime_baseline
!results/archive/early_characterization/local_latency_breakdown
!results/archive/early_characterization/local_inference_concurrency
!results/archive/early_characterization/figures
!results/archive/concurrency_discovery/README.md
!results/archive/residual_exploration/README.md

# Python cache와 가상 환경
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/
ENV/

# Editor 임시 파일
.idea/
.vscode/
*.swp
*.swo
*~

# OS 임시 파일
.DS_Store
Thumbs.db
desktop.ini
