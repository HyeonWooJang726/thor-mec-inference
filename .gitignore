# 로컬 환경 변수와 자격 증명
.env
.env.*
credentials
credentials/**
*credentials*
*api_key*
*apikey*
*token*
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.pem
*.key

# 모델과 TensorRT 생성물
*.onnx
*.engine
*.plan

# 저장소 위치와 무관하게 보호할 연구 raw artifact
*.bin
*.log
*.mp4
*.avi
*.mkv
*.mov
datasets/
dataset/
data/

# raw 결과와 로그는 로컬에 보존하되 공개 Git에는 포함하지 않는다.
logs/*
results/*
!logs/.gitkeep
!results/.gitkeep
!results/decode_profiling/
results/decode_profiling/*
!results/decode_profiling/README.md
!results/decode_profiling/formal_runs.csv
!results/decode_profiling/summary.csv
!results/decode_profiling/figures/
results/decode_profiling/figures/*
!results/decode_profiling/figures/aggregate_throughput_vs_streams.png

# Python cache와 가상 환경
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/
ENV/

# Editor 임시 파일
.idea/
.vscode/
*.swp
*.swo
*~

# OS 임시 파일
.DS_Store
Thumbs.db
desktop.ini
